    {"id": "future-fixture", "from": "fixture-table", "to": "schedule-match", "label": "future fixture", "classification": "read-only", "variant": "security", "route": "straight", "labelAt": [637, 656]},
    {"id": "eda-products", "from": "eda-compare", "to": "dashboard-report", "label": "insights and figures", "classification": "descriptive", "variant": "emphasis", "route": "auto", "labelAt": [858, 202]},
