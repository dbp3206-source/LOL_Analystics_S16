    {"id": "model-probability", "from": "stats-model", "to": "prediction-output", "label": "matchup probability", "classification": "not betting advice", "variant": "dashed", "route": "auto", "labelAt": [858, 454]},
    {"id": "prediction-context", "from": "schedule-match", "to": "prediction-output", "label": "official status", "classification": "fresh or hypothetical", "variant": "security", "route": "auto", "labelAt": [858, 544]}
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "Reproducible Python pipeline",
      "items": [
        "Every stage is callable from the VS Code terminal or Tasks menu",
        "Raw evidence, SQLite facts, CSV tables, figures, and reports remain auditable",
        "Incremental upserts avoid duplicating source game IDs"
      ]
    },
    {
      "dot": "rose",
      "title": "Analysis safety",
      "items": [
        "Only official S16 matches enter the primary analytical scope",
        "Quality gates run before EDA, comparison, or prediction",
        "Cross-role and small-sample results carry explicit warnings"
      ]
    },
    {
      "dot": "orange",
      "title": "Prediction contract",
      "items": [
        "Walk-forward evaluation prevents future data leakage",
        "Brier score and log loss evaluate probability quality",
        "No valid future fixture means the result is hypothetical"
      ]
    }
  ]
